<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">
       
	<bean id ="StudentInfo" class="com.klu.model.Student">
		<constructor-arg value="1"></constructor-arg>
		<constructor-arg value="Pavani"></constructor-arg>
		<constructor-arg value="FSAD1"></constructor-arg>
		<constructor-arg value="1"></constructor-arg>
		<property name = "courseName" value="FSAD"></property>
		<property name = "year" value="2"></property>
	</bean>
</beans>